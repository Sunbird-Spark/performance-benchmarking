{
  "description": "How `bench token` gets a user token: the same two calls as the Postman 'User Token Generation' folder. {{name}} is replaced with a value from the environment file or from an earlier step. `extract` saves a response field (dot path) under a variable name. The JMX files read those names, e.g. ${__P(user_access_token,)}.",
  "steps": [
    {
      "name": "Keycloak login",
      "method": "POST",
      "url": "{{host}}/auth/realms/sunbird/protocol/openid-connect/token",
      "headers": { "Authorization": "Bearer {{apikey}}" },
      "form": {
        "client_id": "{{admin_client_id}}",
        "client_secret": "{{admin_client_secret}}",
        "grant_type": "password",
        "username": "{{username}}",
        "password": "{{password}}"
      },
      "extract": { "user_refresh_token": "refresh_token" }
    },
    {
      "name": "Gateway refresh",
      "method": "POST",
      "url": "{{host}}/auth/v1/refresh/token",
      "headers": { "Authorization": "Bearer {{apikey}}" },
      "form": { "refresh_token": "{{user_refresh_token}}" },
      "extract": { "user_access_token": "result.access_token" }
    }
  ]
}
